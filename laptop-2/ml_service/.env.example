# MQTT broker on Laptop 2. Replace with Laptop 2's current LAN/hotspot IP
# in your private .env file; do not put passwords in this example file.
MQTT_HOST=replace_with_laptop_2_ip
MQTT_PORT=1883
MQTT_USERNAME=evdt_user
MQTT_PASSWORD=replace_me_locally

STATION_ID=STATION-001
MODEL_DIR=../models
LOG_LEVEL=INFO
