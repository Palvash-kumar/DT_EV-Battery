# Mac — OPC UA -> MQTT bridge
# Copy to .env (first time only): cp opcua_bridge/.env.example opcua_bridge/.env
# NEVER commit .env to Git.

# OPC UA server on the sensor laptop (Windows, Arduino plugged in).
# Use its reserved IP; the sensor laptop prints the exact URL when it starts.
OPCUA_URL=opc.tcp://<sensor-laptop-ip>:4840/evdt
OPCUA_NAMESPACE_URI=urn:evdt:sensor

# Mosquitto runs on this Mac
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Broker user that may only publish evdt/v1/telemetry/temperature (mosquitto/acl)
MQTT_USERNAME=opcbridge
MQTT_PASSWORD=opcbridge_pass_2026
MQTT_TOPIC_TELEMETRY_TEMP=evdt/v1/telemetry/temperature

# Warn when this Mac's clock and the sensor laptop's clock differ by more than this (s)
MAX_CLOCK_SKEW_SEC=5

LOG_LEVEL=INFO
