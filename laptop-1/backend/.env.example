# Laptop 1 — Backend Environment
# Copy to .env and fill in values. NEVER commit .env to Git.

PORT=3000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MQTT Broker (Laptop 2's IP on the LAN)
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backend_pass_2026

# MongoDB
MONGODB_URI=replace_with_your_atlas_connection_string

# Station
STATION_ID=STATION-001

# Topics
MQTT_TOPIC_REQUESTS=evdt/v1/requests/charging
MQTT_TOPIC_RESULTS_CHARGING=evdt/v1/results/charging
MQTT_TOPIC_RESULTS_HEALTH=evdt/v1/results/health
MQTT_TOPIC_RESULTS_OPTIMIZATION=evdt/v1/results/optimization
MQTT_TOPIC_TELEMETRY_TEMP=evdt/v1/telemetry/temperature
MQTT_TOPIC_ALERTS=evdt/v1/alerts

# Request timeout (seconds)
REQUEST_TIMEOUT_SEC=15

# Simulated sessions: 60 means one real second = one simulated minute
SIM_TIME_SCALE=60
# Simulated telemetry readings are deleted after this many days (sensor readings are kept)
TELEMETRY_SIM_TTL_DAYS=7

# Arduino temperature sensor (Phase 10)
# A real sensor reading older than this is "offline": it can't be used in a
# request and a sensor_offline alert is raised.
SENSOR_STALE_SEC=30
# Used by "npm run gateway:arduino" on the laptop the Arduino is plugged into.
# auto = first Arduino found by USB vendor id; or e.g. COM6
ARDUINO_SERIAL_PORT=auto
ARDUINO_BAUD=9600
SENSOR_ID=LM35-A0-01
# calibrated | uncalibrated | unknown. Only "calibrated" readings get quality "good".
SENSOR_CALIBRATION=uncalibrated
# One-point calibration: added to every reading, in °C (e.g. -0.8)
SENSOR_OFFSET_C=0
# Broker login of the gateway (ACL: may only publish evdt/v1/telemetry/temperature)
SENSOR_MQTT_USERNAME=sensor
SENSOR_MQTT_PASSWORD=sensor_pass_2026

# Rate limits per client IP, per minute
RATE_LIMIT_PER_MIN=300
PREDICTION_RATE_LIMIT_PER_MIN=30

# MQTT archiver (npm run archive:mqtt): copies every MQTT message into
# Atlas database "mosquitto", collection "messages". Optional, separate process.
# Needs a user that may READ evdt/v1/# ("backend" may not read requests).
ARCHIVER_MQTT_USERNAME=admin
ARCHIVER_MQTT_PASSWORD=admin_pass_2026
ARCHIVER_TTL_DAYS=7
