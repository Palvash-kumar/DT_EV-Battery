{
  "name": "evdt-backend",
  "version": "0.7.0",
  "private": true,
  "description": "Laptop 1 API for the EV charging station digital twin. Owns MQTT, MongoDB and Socket.IO.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:broker": "node scripts/dev-broker.js",
    "dev:stub-worker": "node scripts/stub-worker.js",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 \"test/**/*.test.js\"",
    "dev:sim-telemetry": "node scripts/sim-telemetry.js",
    "db:init": "node scripts/db.js init",
    "db:seed": "node scripts/db.js seed",
    "db:import-csv": "node scripts/db.js import-csv",
    "db:setup": "node scripts/db.js init seed import-csv",
    "archive:mqtt": "node scripts/mqtt-archiver.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.10",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
