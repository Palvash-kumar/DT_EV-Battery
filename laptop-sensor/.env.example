# Sensor laptop (Windows, Arduino plugged in by USB) — OPC UA server
# Copy to .env (first time only). NEVER commit .env to Git.

# Station and sensor identity (StationId must match STATION_ID on the web laptop)
STATION_ID=STATION-001
SENSOR_ID=LM35-A0-01

# Arduino serial port: auto = first Arduino found by USB vendor id; or e.g. COM6
ARDUINO_SERIAL_PORT=auto
ARDUINO_BAUD=9600

# calibrated | uncalibrated | unknown
SENSOR_CALIBRATION=uncalibrated
# One-point calibration offset added to every reading, in °C (e.g. -0.8)
SENSOR_OFFSET_C=0

# How often the OPC UA value is updated with the newest reading (seconds).
# The Arduino prints every ~2.2 s. 0 = update on every Arduino line.
SENSOR_PUBLISH_INTERVAL_SEC=5
# No valid reading for this long -> TemperatureC status BadNoCommunication, SensorState offline
SENSOR_STALE_SEC=30

# OPC UA server: opc.tcp://<this laptop's IP>:<OPCUA_PORT><OPCUA_RESOURCE_PATH>
OPCUA_PORT=4840
OPCUA_RESOURCE_PATH=/evdt
# Optional: name used in the advertised endpoint URL (default: this computer's name).
# This laptop's IP addresses are always advertised too.
# OPCUA_HOSTNAME=
